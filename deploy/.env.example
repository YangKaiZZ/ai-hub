# Copy to deploy/.env on the server and fill in. Never commit the real file.
#
# Generate the three secrets with:
#   openssl rand -base64 36                      # SESSION_SECRET
#   openssl rand -hex 32                         # INTEGRATION_ENCRYPTION_KEY
#   openssl rand -base64 24 | tr -d '/+=' | cut -c1-28   # POSTGRES_PASSWORD

# The hostname Caddy serves. No scheme, no trailing slash.
DOMAIN=aihub.aiops-cocenter.site

# At least 32 characters. Changing it signs everyone out.
SESSION_SECRET=

# Exactly 64 hex characters. This encrypts stored LMS tokens:
# rotating it makes existing integrations unreadable and users must reconnect.
INTEGRATION_ENCRYPTION_KEY=

# Database password. Only the app container ever uses it.
POSTGRES_PASSWORD=
DATABASE_POOL_MAX=10

# AI: deepseek | anthropic | mock
# mock needs no key and returns deterministic demo output, labelled in the UI.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Daily AI allowance, in successful AI calls per UTC day. 0 means no limit.
# PER_USER: each normal account. DEMO: shared by everyone using the demo login.
# TOTAL: all users combined, the ceiling on what the API key can be charged for.
AI_DAILY_LIMIT_PER_USER=50
AI_DAILY_LIMIT_DEMO=150
AI_DAILY_LIMIT_TOTAL=500

# Only needed if AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5

# Uploads
MAX_UPLOAD_MB=25

# true = LMS connections return realistic sample data instead of calling a school.
LMS_MOCK_MODE=true

# true: reset the two demo accounts to fresh sample data whenever the app starts.
SEED_DEMO=false

# true: also reset them once a day at DEMO_RESET_HOUR_UTC. Visitors share the demo
# login, so this clears whatever they add, and keeps the sample deadlines current.
DEMO_NIGHTLY_RESET=false
DEMO_RESET_HOUR_UTC=4
